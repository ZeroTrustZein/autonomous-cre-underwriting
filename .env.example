# Autonomous CRE Underwriting Swarm Configuration

# MCP Servers
MUNICIPAL_DEED_MCP_URL=http://localhost:8101/mcp
SEC_EDGAR_MCP_URL=http://localhost:8102/mcp

# Vector / Graph Storage
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_STORE_PATH=./data/vector_store
GRAPH_STORE_PATH=./data/graph_store

# Swarm Execution
SWARM_MAX_CONCURRENT_TASKS=8
SWARM_EVENT_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
